<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="16dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="16dp"
    android:orientation="vertical"
    tools:context=".ManageAccountActivity">


    <TextView
        android:id="@+id/manageAccountEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your should never see this" />
    <TextView
        android:id="@+id/manageAccountEmailVerified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your should never see this" />
    <TextView
        android:id="@+id/manageAccountTechnicalId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your should never see this" />

    <Button
        android:id="@+id/manageAccountSignOut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Out" />

    <Button
        android:id="@+id/manageAccountSendActivationMail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Send Activation Mail" />


    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight = "1"/>

    <TextView
        android:id="@+id/passwordText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pls enter your password before we delete your account." />

    <EditText
        android:id="@+id/editTextTextPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/button4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF5722"
        android:text="Delete Account" />

</LinearLayout>