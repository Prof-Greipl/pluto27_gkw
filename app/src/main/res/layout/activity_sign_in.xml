<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="16dp"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="16dp"
    tools:context=".SignInActivity"
    android:orientation="vertical"
    >

    <EditText
        android:id="@+id/signin_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Enter a valid e-mail address"
        android:inputType="textEmailAddress" />

    <EditText
        android:id="@+id/signin_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Enter a password (min 6 chars)"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/signin_button_signin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign In" />

    <Button
        android:id="@+id/signin_button_reset_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reset Password" />" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter your e-mail to receive a password reset link" />

    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight = "1"/>

    <Button
        android:id="@+id/signin_button_register"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create Account" />


</LinearLayout>